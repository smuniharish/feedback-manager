# Example environment for feedback-manager development. feedback-manager itself
# reads no environment variables: behaviour is configured in code, per
# FeedbackManager instance. Each variable below is read by the component named
# in its group heading. Never commit real credentials.

# Read by the PostgreSQL examples (examples/postgres_feedback_store.py,
# 10_full_matrix_feedback.py, 11_grafana_dashboard.py,
# 12_organic_scenarios_postgres.py, streamlit_feedback_ui.py).
FEEDBACK_MANAGER_POSTGRES_DSN=

# Read by examples/11_grafana_dashboard.py.
FEEDBACK_MANAGER_GRAFANA_URL=
FEEDBACK_MANAGER_GRAFANA_USER=
FEEDBACK_MANAGER_GRAFANA_PASSWORD=
FEEDBACK_MANAGER_GRAFANA_POSTGRES_HOST=

# Read by examples/15_background_learning.py; unset uses a temporary directory.
FEEDBACK_MANAGER_STATE_DIR=

# Read by the model-backed examples (07_agent_mcp_create_agent.py,
# 08_agent_deepagents_hitl.py), plus the provider's own credentials such as
# OPENAI_API_KEY and OPENAI_BASE_URL.
FEEDBACK_MANAGER_EXAMPLE_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Read by the opt-in PostgreSQL test suite. Point it at a disposable database;
# pytest skips the suite when the variable is unset.
FEEDBACK_MANAGER_TEST_POSTGRES_DSN=
