FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FEEDBACK_MANAGER_STATE_DIR=/data
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir ".[lancedb,ladybugdb]" \
    && groupadd --gid 10001 feedback \
    && useradd --uid 10001 --gid 10001 --no-create-home feedback \
    && mkdir /data && chown 10001:10001 /data
COPY examples ./examples
USER 10001:10001
CMD ["python", "examples/15_background_learning.py"]
